# Database Connection URL (PostgreSQL via Supabase Pooler or direct)
DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# JWT Secret (generate a strong one: openssl rand -hex 32)
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"

# Admin Setup Secret (used only once to create the first admin account)
ADMIN_SECRET="kamra-kiraya-admin-2024"

# SMTP Email Configuration (for password reset, notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@kamarakiraya.com"

# UPI Gateway Configurations (for Payments)
UPI_ID="your-merchant-upi-id@bank"
UPI_NAME="Your Business Name"
UPI_NOTE="Room booking payment"
NEXT_PUBLIC_UPI_ID="your-merchant-upi-id@bank"

# Google Gemini AI (free fallback when Ollama is offline)
# Get key: https://aistudio.google.com/apikey
# Free tier: 60 requests/min, no credit card needed
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Ollama AI (for recommendations & chatbot - run locally)
# Install: https://ollama.com
# Pull models: ollama pull llama3.2:3b && ollama pull nomic-embed-text
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
