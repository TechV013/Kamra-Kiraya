# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Runtime URL: use the Supabase *transaction* pooler (port 6543) on serverless
# platforms so concurrent functions do not exhaust connections.
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# Migration URL: direct connection (port 5432). Used by `prisma migrate deploy`.
DIRECT_URL="postgresql://user:password@db.project-ref.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# JWT Secret (generate a strong one: openssl rand -hex 32)
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"

# Admin Setup Secret (used once to create the first admin account; required —
# the app refuses to create admins if this is unset)
ADMIN_SECRET="generate-a-strong-random-secret"

# ---------------------------------------------------------------------------
# Storage (Supabase bucket)
# ---------------------------------------------------------------------------
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ---------------------------------------------------------------------------
# SMTP Email (required for password reset)
# ---------------------------------------------------------------------------
# Gmail: use an App Password. Resend/SendGrid also work as generic SMTP.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@kamarakiraya.com"

# ---------------------------------------------------------------------------
# UPI Gateway Configurations (for Payments)
# ---------------------------------------------------------------------------
UPI_ID="your-merchant-upi-id@bank"
UPI_NAME="Your Business Name"
UPI_NOTE="Room booking payment"
NEXT_PUBLIC_UPI_ID="your-merchant-upi-id@bank"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# Google Gemini (required in production — Ollama is local-only and skipped on Vercel)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

# Ollama (local development only, never reachable from serverless hosting)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# ---------------------------------------------------------------------------
# App Settings
# ---------------------------------------------------------------------------
# Public site URL — used in password reset links and emails. Must be the real
# domain in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
