generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum Role {
  STUDENT
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  VERIFICATION_PENDING
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  DORMITORY
  STUDIO
  APARTMENT
}

enum BookingType {
  DAILY
  MONTHLY
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  INACTIVE
}

enum MessageType {
  TEXT
  SYSTEM
  IMAGE
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ComplaintCategory {
  MAINTENANCE
  PAYMENT
  REFUND
  PROPERTY_ISSUE
  HARASSMENT
  FAKE_LISTING
  OTHER
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  password            String
  phone               String?
  avatar              String?
  role                Role      @default(STUDENT)
  isVerified          Boolean   @default(false)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetToken          String?
  resetTokenExpiry    DateTime?
  upiId               String?
  upiName             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  rooms               Room[]
  bookings            Booking[]
  reviews             Review[]
  wishlist            Wishlist[]
  notifications       Notification[]
  sentMessages        Message[]
  ownerVerification   OwnerVerification?
  reviewedVerifications OwnerVerification[] @relation("VerificationReviews")
  complaintsFiled       Complaint[]        @relation("ComplaintsFiled")
  complaintsReceived    Complaint[]        @relation("ComplaintsReceived")
  complaintResolutions  Complaint[]        @relation("ComplaintResolution")
  complaintClosures     Complaint[]        @relation("ComplaintClosure")
  complaintMessages     ComplaintMessage[]
  complaintStatusChanges ComplaintStatusHistory[]
  auditLogs              AuditLog[]

  @@map("users")
}

model Room {
  id             String         @id @default(cuid())
  title          String
  description    String
  address        String
  city           String
  state          String
  zipCode        String?
  latitude       Float?
  longitude      Float?
  priceDaily     Float
  priceMonthly   Float
  roomType       RoomType       @default(SINGLE)
  status         PropertyStatus @default(PENDING)
  maxOccupancy   Int            @default(1)
  totalRooms     Int            @default(1)
  availableRooms Int            @default(1)
  images         String[]
  amenities      String[]
  rules          String[]
  rating         Float          @default(0)
  reviewCount    Int            @default(0)
  viewCount      Int            @default(0)
  isAvailable    Boolean        @default(true)
  ownerId        String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings       Booking[]
  reviews        Review[]
  wishlist       Wishlist[]
  availability   RoomAvailability[]

  @@index([city, status])
  @@index([priceDaily, priceMonthly])
  @@index([status, createdAt])
  @@index([ownerId])
  @@map("rooms")
}

model Booking {
  id          String        @id @default(cuid())
  roomId      String
  studentId   String
  bookingType BookingType
  checkIn     DateTime
  checkOut    DateTime
  totalDays   Int
  totalAmount Float
  status      BookingStatus @default(PENDING)
  specialNote String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  room        Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment     Payment?
  messages    Message[]
  complaints Complaint[]

  @@map("bookings")
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  ownerUpiId        String?
  platformFee       Float         @default(0)
  ownerPayout       Float         @default(0)
  refundId          String?
  paymentReference  String?
  transactionRef    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("wishlists")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("info")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Message {
  id         String      @id @default(cuid())
  bookingId  String
  senderId   String
  content    String
  type       MessageType @default(TEXT)
  isRead     Boolean     @default(false)
  createdAt  DateTime    @default(now())

  booking    Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("messages")
}

model PlatformConfig {
  key         String  @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("platform_configs")
}

model OwnerVerification {
  id               String             @id @default(cuid())
  ownerId          String             @unique
  status           VerificationStatus @default(PENDING)
  aadhaarUrl       String?
  panUrl           String?
  propertyProofUrl String?
  rejectionNote    String?
  reviewedBy       String?
  reviewedAt       DateTime?
  submittedAt      DateTime            @default(now())
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  owner            User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reviewer         User?              @relation("VerificationReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("owner_verifications")
}

model Complaint {
  id              String           @id @default(cuid())
  bookingId       String?
  complainantId   String
  respondentId    String
  category        ComplaintCategory
  status          ComplaintStatus  @default(OPEN)
  title           String
  description     String
  attachments     String[]
  resolution      String?
  resolvedById    String?
  closedById      String?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  complainant     User             @relation("ComplaintsFiled", fields: [complainantId], references: [id], onDelete: Cascade)
  respondent      User             @relation("ComplaintsReceived", fields: [respondentId], references: [id], onDelete: Cascade)
  booking         Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  resolver        User?            @relation("ComplaintResolution", fields: [resolvedById], references: [id], onDelete: SetNull)
  closer          User?            @relation("ComplaintClosure", fields: [closedById], references: [id], onDelete: SetNull)
  messages        ComplaintMessage[]
  statusHistory   ComplaintStatusHistory[]

  @@index([complainantId])
  @@index([respondentId])
  @@index([status])
  @@map("complaints")
}

model ComplaintMessage {
  id          String   @id @default(cuid())
  complaintId String
  senderId    String
  message     String
  attachments String[]
  createdAt   DateTime @default(now())

  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_messages")
}

model ComplaintStatusHistory {
  id          String          @id @default(cuid())
  complaintId String
  fromStatus  ComplaintStatus?
  toStatus    ComplaintStatus
  changedById String
  note        String?
  createdAt   DateTime        @default(now())

  complaint   Complaint       @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  changedBy   User            @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_status_history")
}

model RoomAvailability {
  id             String   @id @default(cuid())
  roomId         String
  date           DateTime
  availableCount Int      @default(1)
  reservedCount  Int      @default(0)
  isBlocked      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([roomId, date])
  @@map("room_availability")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  Json     @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}